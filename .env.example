# Copy to .env (gitignored). Never commit real keys.

# NVIDIA API key: https://build.nvidia.com  (starts with nvapi-)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Model served by NVIDIA's OpenAI-compatible endpoint.
# Verify it is available to your key:
#   curl https://integrate.api.nvidia.com/v1/models -H "Authorization: Bearer $NVIDIA_API_KEY"
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Optional override of the API base URL
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Local dev server port
PORT=3000
